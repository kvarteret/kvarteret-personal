{
  "name": "kvarteret-personal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "scripts": {
    "build:css": "bunx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/css/output.css",
    "build:js": "bun build ./app/static/js/vercel-observability.ts --outfile ./app/static/js/vercel-observability.js --format esm --target browser --define process.env.NODE_ENV='\"production\"'",
    "build:email-previews": "python ./scripts/render_email_previews.py",
    "build:emails": "bun run ./scripts/compile_mjml_templates.mjs && bun run build:email-previews",
    "build:i18n": "python ./scripts/compile_gettext_catalogs.py",
    "build:assets": "bun run build:css && bun run build:js && bun run build:emails && bun run build:i18n",
    "watch:css": "bunx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/css/output.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvarteret/kvarteret-personal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kvarteret/kvarteret-personal/issues"
  },
  "homepage": "https://github.com/kvarteret/kvarteret-personal#readme",
  "description": "FastAPI replacement for Kvarteret Personal",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "mjml": "^4.15.3",
    "tw-animate-css": "^1.4.0"
  }
}
