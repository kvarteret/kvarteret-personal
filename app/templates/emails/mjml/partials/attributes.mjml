<mj-font name="Fraunces" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;650;700&amp;display=swap" />
<mj-font name="DM Sans" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&amp;display=swap" />
<mj-font name="DM Mono" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&amp;display=swap" />
<mj-attributes>
  <mj-all font-family="DM Sans, Arial, Helvetica, sans-serif" color="#26211e" />
  <mj-body background-color="#faf7f2" width="600px" />
  <mj-section background-color="#faf7f2" padding="0 24px" />
  <mj-column padding="0" />
  <mj-text font-size="16px" line-height="26px" padding="0 0 18px" />
  <mj-button background-color="#db242a" color="#ffffff" border="0" border-radius="6px" font-size="16px" line-height="24px" font-weight="700" align="left" inner-padding="16px 22px" padding="12px 0 32px" />
</mj-attributes>
