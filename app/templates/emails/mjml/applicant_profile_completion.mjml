<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Din reise starter nå</mj-title>
    <mj-preview>Prøveperioden din har startet.</mj-preview>
    <mj-include path="./partials/attributes.mjml" />
  </mj-head>
  <mj-body>
    <mj-include path="./partials/header.mjml" />
    <mj-section padding="30px 24px 24px">
      <mj-column>
        <mj-text padding="0"><h1 style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Fraunces,Georgia,Times New Roman,serif;font-size:36px;font-weight:700;line-height:42px;letter-spacing:-1px;color:#26211e;">Din reise starter nå / Your journey starts now</h1></mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text>Your trial period has now started. Complete your profile to access your temporary staff ID, internal benefits, and relevant information during your trial period.</mj-text>
        <mj-text>Din prøveperiode er nå i gang. Fullfør profilen din for å få tilgang til midlertidig internbevis, interne goder og relevant informasjon gjennom prøveperioden.</mj-text>
        <mj-button href="{{ invitation_url }}">Complete your profile / Fullfør profilen din</mj-button>
        <mj-text color="#6f655e" font-size="14px" line-height="22px" padding="0 0 6px">Direct link / Direkte lenke</mj-text>
        <mj-text color="#6f655e" font-size="14px" line-height="22px"><a href="{{ invitation_url }}" style="color:#b9252b; word-break:break-word;">{{ invitation_url }}</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
