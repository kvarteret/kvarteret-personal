<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" color="#111111" />
      <mj-body background-color="#ffffff" />
      <mj-column padding="0" />
      <mj-text font-size="16px" line-height="24px" padding="0" />
      <mj-button
        background-color="#f54b4b"
        color="#ffffff"
        border="0"
        border-radius="0"
        font-size="16px"
        font-weight="700"
        inner-padding="14px 20px"
        padding="0"
      />
    </mj-attributes>
    <mj-title>Complete your Kvarteret profile</mj-title>
    <mj-preview>Finish the rest of your profile in Det Akademiske Kvarter.</mj-preview>
  </mj-head>
  <mj-body>
    <mj-section padding="0" background-color="#f54b4b">
      <mj-column>
        <mj-text
          font-size="24px"
          line-height="32px"
          font-weight="700"
          color="#ffffff"
          padding="20px 24px"
        >
          Complete your profile
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0" background-color="#ffffff">
      <mj-column>
        <mj-text padding="24px 24px 0">
          You are now registered as a volunteer at Det Akademiske Kvarter. Use the link below to complete the rest of your profile.
        </mj-text>
        <mj-text padding="14px 24px 0">
          Du er nå registrert som frivillig i Det Akademiske Kvarter. Bruk lenken under for å fullføre resten av profilen din.
        </mj-text>
        <mj-button href="{{ invitation_url }}" padding="24px 24px 0">
          Complete your profile / Fullfør profilen din
        </mj-button>
        <mj-text padding="20px 24px 6px" font-size="14px" line-height="22px">
          Direct link / Direkte lenke
        </mj-text>
        <mj-text padding="0 24px 24px" font-size="14px" line-height="22px">
          <a href="{{ invitation_url }}" style="color:#f54b4b; word-break:break-word;">{{ invitation_url }}</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
