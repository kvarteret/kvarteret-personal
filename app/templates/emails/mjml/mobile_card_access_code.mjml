<mjml>
  <mj-head>
    <mj-title>Kvarteret Internkort</mj-title>
    <mj-preview>Your Kvarteret verification code is ready.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" color="#111111" />
      <mj-text font-size="16px" line-height="24px" />
      <mj-button
        background-color="#f54b4b"
        border="0"
        color="#ffffff"
        font-size="16px"
        font-weight="700"
        inner-padding="16px 20px"
      />
      <mj-section background-color="#ffffff" padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#ffffff">
    <mj-section background-color="#f54b4b" padding="0">
      <mj-column>
        <mj-text
          color="#ffffff"
          font-size="24px"
          font-weight="700"
          line-height="32px"
          padding="20px 24px"
        >
          Your verification code
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0">
      <mj-column>
        <mj-text padding="24px 24px 16px">
          Use this code to sign in to Kvarteret Internkort.
        </mj-text>
        <mj-raw>
          <div style="margin:0 24px;background-color:#f54b4b;color:#ffffff;font-family:Helvetica, Arial, sans-serif;font-size:30px;font-weight:700;line-height:38px;text-align:center;padding:18px 12px;">
            {{ access_code }}
          </div>
        </mj-raw>
        <mj-text padding="16px 24px 0">
          This code expires in {{ expires_in_minutes }} minutes.
        </mj-text>
        <mj-text color="#555555" font-size="14px" padding="8px 24px 24px">
          If you did not request this code, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
