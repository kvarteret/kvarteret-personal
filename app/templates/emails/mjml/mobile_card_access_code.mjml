<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Samfunnet i Bergen Internkort</mj-title>
    <mj-preview>Your Samfunnet i Bergen verification code is ready.</mj-preview>
    <mj-include path="./partials/attributes.mjml" />
  </mj-head>
  <mj-body>
    <mj-include path="./partials/header.mjml" />
    <mj-section padding="30px 24px 24px">
      <mj-column>
        <mj-text padding="0"><h1 style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Fraunces,Georgia,Times New Roman,serif;font-size:36px;font-weight:700;line-height:42px;letter-spacing:-1px;color:#26211e;">Your verification code</h1></mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text>Use this code to sign in to Samfunnet i Bergen Internkort.</mj-text>
        <mj-text font-family="DM Mono, Courier New, Courier, monospace" padding="8px 0 24px"><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;padding-top:24px;padding-right:12px;padding-bottom:24px;padding-left:12px;color:#754315;font-family:DM Mono,Courier New,Courier,monospace;font-size:36px;line-height:44px;font-weight:700;letter-spacing:8px;text-align:center;">{{ access_code }}</p></mj-text>
        <mj-text>This code expires in {{ expires_in_minutes }} minutes.</mj-text>
        <mj-text color="#6f655e" font-size="14px" line-height="22px">If you did not request this code, you can ignore this email.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
