<mjml>
  <mj-head>
    <mj-title>Kvarteret Internkort</mj-title>
    <mj-preview>Your Kvarteret verification code is ready.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" color="#161b2b" />
      <mj-text font-size="16px" line-height="24px" />
      <mj-button
        background-color="#d99127"
        border="2px solid #161b2b"
        color="#161b2b"
        font-size="16px"
        font-weight="700"
        inner-padding="16px 20px"
      />
      <mj-section background-color="#fff7e4" padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      .shell {
        border: 2px solid #161b2b;
        box-shadow: 6px 6px 0 #161b2b;
      }
      .eyebrow div {
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .code-block div {
        letter-spacing: 0.35em;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fff7e4">
    <mj-section css-class="shell" background-color="#fffaf0" padding="0">
      <mj-column>
        <mj-text
          css-class="eyebrow"
          background-color="#161b2b"
          color="#fff7e4"
          font-size="12px"
          font-weight="700"
          padding="20px 24px 0"
        >
          Kvarteret Internkort
        </mj-text>
        <mj-text
          background-color="#161b2b"
          color="#fff7e4"
          font-size="28px"
          font-weight="700"
          line-height="34px"
          padding="12px 24px 20px"
        >
          Your verification code
        </mj-text>
        <mj-text padding="24px 24px 16px">
          Use this code to sign in to Kvarteret Internkort.
        </mj-text>
        <mj-raw>
          <div style="margin:0 24px;border:2px solid #161b2b;background-color:#d99127;color:#161b2b;font-family:Helvetica, Arial, sans-serif;font-size:30px;font-weight:700;line-height:38px;letter-spacing:0.35em;text-align:center;padding:18px 12px;">
            {{ access_code }}
          </div>
        </mj-raw>
        <mj-text padding="16px 24px 0">
          This code expires in {{ expires_in_minutes }} minutes.
        </mj-text>
        <mj-text color="#3d465f" font-size="14px" padding="8px 24px 24px">
          If you did not request this code, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
