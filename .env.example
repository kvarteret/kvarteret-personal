DATABASE_USE_NULL_POOL=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
PHOTO_BUCKET=personnel-photos
DOCUMENT_BUCKET=personnel-documents
REVIEW_BYPASS_ENABLED=false
REVIEW_BYPASS_EMAIL=
REVIEW_BYPASS_TOKEN=
PENDING_VOLUNTEER_APPLICATIONS_CACHE_TTL_SECONDS=30
MOBILE_CARD_ACCESS_CODE_TTL_MINUTES=10
MOBILE_CARD_ACCESS_CODE_COOLDOWN_SECONDS=60
MOBILE_CARD_SESSION_TTL_DAYS=7
